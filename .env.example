# Supabase
# Get from: Supabase Dashboard → Settings → API Keys
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use the "Publishable" key (sb_publishable_...) — safe to expose in frontend
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# Use the "Secret" key (sb_secret_...) — NEVER expose in frontend code
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key-here

# Mock Mode — set true for local dev (no real Supabase), false for production
VITE_USE_MOCK=false

# Resend Email
RESEND_API_KEY=re_your-resend-api-key

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# Application
VITE_APP_URL=http://localhost:3000
VITE_CLINIC_TIMEZONE=Asia/Kolkata

# Demo Credentials (for development only)
# Admin:  admin@healthcare.demo   / Demo@1234
# Doctor: dr.sharma@healthcare.demo / Demo@1234
# Patient: patient@healthcare.demo / Demo@1234
